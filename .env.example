# Copy to .env for local development only. Never commit .env.
# Local PGlite storage is used when DATABASE_URL is unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/ui_spec_studio

# Uncomment only for local development without accounts.
# AUTH_DISABLED=true

# A production deployment requires a privately configured, stable secret.
# BETTER_AUTH_SECRET=<replace-with-random-secret>

PING_MESSAGE=pong
